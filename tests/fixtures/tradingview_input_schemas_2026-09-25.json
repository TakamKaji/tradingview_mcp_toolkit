{
  "retrievedAt": "2026-09-25",
  "protocolVersion": "2025-11-25",
  "serverVersion": "1.30.0",
  "tools": {
    "mcp-tv-create-alert": {
      "type": "object",
      "properties": {
        "symbol": {
          "type": "string",
          "description": "Symbol in EXCHANGE:TICKER format"
        },
        "price": {
          "type": "number",
          "description": "Price threshold for a simple price condition"
        },
        "condition": {
          "type": "string",
          "description": "Price condition type: cross, cross_up, cross_down, greater, less. Default cross"
        },
        "message": {
          "type": "string",
          "description": "Message shown when the alert fires (max 4000 chars)"
        },
        "name": {
          "type": "string",
          "description": "Alert name (max 300 chars)"
        },
        "resolution": {
          "type": "string",
          "description": "Chart resolution the alert is evaluated on: 1, 60 (hour), 1D, ... Default 1"
        },
        "expiration": {
          "type": "string",
          "description": "ISO expiration time; default now+30d"
        },
        "auto_deactivate": {
          "type": "boolean",
          "description": "Deactivate the alert after the first fire. Default false"
        },
        "email": {
          "type": "boolean",
          "description": "Send email on fire. Default false"
        },
        "mobile_push": {
          "type": [
            "null",
            "boolean"
          ],
          "description": "Send mobile push on fire. Default true"
        },
        "popup": {
          "type": [
            "null",
            "boolean"
          ],
          "description": "Show popup on fire. Default true"
        },
        "conditions": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "Raw condition payload (overrides price/condition). Only a single price condition with barset/value series is accepted; multi-condition and indicator (study) conditions are not supported yet and are rejected"
        }
      },
      "required": [
        "symbol"
      ],
      "patternProperties": {
        "^(webhook|monitor)$": true
      },
      "additionalProperties": false
    },
    "mcp-tv-delete-alert": {
      "type": "object",
      "properties": {
        "alert_ids": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "integer"
          },
          "description": "Alert ids"
        }
      },
      "required": [
        "alert_ids"
      ],
      "additionalProperties": false
    },
