{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(.local/**)",
      "Edit(.local/**)",
      "Read(runtime/**)",
      "Edit(runtime/**)",
      "Edit(results/**)"
    ]
  }
}
